FROM node:20-bullseye

WORKDIR /app

# Install Python 3, pip, and necessary system dependencies for matplotlib and psycopg2
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Create a virtual environment and install Python dependencies
# We copy requirements first to leverage Docker cache
COPY python_analytics/requirements.txt /app/python_analytics/requirements.txt
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN pip install --no-cache-dir -r /app/python_analytics/requirements.txt

# Command will be overridden by docker-compose, but provide a default
CMD ["npm", "run", "dev"]
